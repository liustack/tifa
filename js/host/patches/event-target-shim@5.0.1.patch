+/**
+ * Patched by tifa: per object state lives in a symbol property of the object instead of a
+ * WeakMap. QuickJS frees a dead cycle that runs through WeakMap values only after more
+ * collections, or not at all when a value leads back to its key, while a property dies with
+ * its object in one collection. The property is defined once, when the object is made, so an
+ * object the application seals or freezes later keeps working. A value set again later, the
+ * aborted flag of a signal, lives in a box whose value changes. The property is not
+ * enumerable, and an object only reads its own.
+ * @private
+ */
+function propertyMap(name, changes) {
+    const key = Symbol(name);
+    const own = Object.prototype.hasOwnProperty;
+    return {
+        get(object) {
+            if (object === null || (typeof object !== "object" && typeof object !== "function") || !own.call(object, key)) {
+                return undefined
+            }
+            return changes ? object[key].value : object[key]
+        },
+        set(object, value) {
+            if (changes && object !== null && typeof object === "object" && own.call(object, key)) {
+                object[key].value = value;
+            } else {
+                Object.defineProperty(object, key, { value: changes ? { value } : value });
+            }
+            return this
+        },
+    }
+}
