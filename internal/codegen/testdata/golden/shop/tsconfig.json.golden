{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "rootDirs": ["..", "."]
  },
  "include": ["../app", "../vite.config.ts", "routes.tsx", "server.ts", "client.ts", "vite.d.ts", "runtime/env.d.ts"]
}
