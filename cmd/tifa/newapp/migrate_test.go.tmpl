package {{.Package}}

import (
	"flag"
	"io/fs"
	"os"
	"path/filepath"
	"regexp"
	"strings"
	"testing"
)

var update = flag.Bool("update", false, "write schema.sql from migrations/")

const schemaHeader = `-- Written by go test -run TestSchema -update from the files of migrations/. Do not edit it:
-- to change a table, add the next numbered file to migrations/ and run that command again.
-- An app on Postgres deletes this file and TestSchema.

`

// schema.sql shows the tables as the files of migrations/ leave them. This test writes it, so a
// change made there by hand fails here instead of on the server.
func TestSchema(t *testing.T) {
	db, err := OpenDB(filepath.Join(t.TempDir(), "app.db"))
	if err != nil {
		t.Fatal(err)
	}
	defer db.Close()
	rows, err := db.Query(`SELECT sql FROM sqlite_schema
		WHERE sql IS NOT NULL AND name NOT LIKE 'sqlite_%' AND name <> 'goose_db_version'
		ORDER BY tbl_name, type <> 'table', name`)
	if err != nil {
		t.Fatal(err)
	}
	var statements []string
	for rows.Next() {
		var s string
		if err := rows.Scan(&s); err != nil {
			t.Fatal(err)
		}
		statements = append(statements, s+";\n")
	}
	if err := rows.Err(); err != nil {
		t.Fatal(err)
	}
	got := schemaHeader + strings.Join(statements, "\n")
	if *update {
		if err := os.WriteFile("schema.sql", []byte(got), 0o644); err != nil {
			t.Fatal(err)
		}
		return
	}
	want, err := os.ReadFile("schema.sql")
	if err != nil {
		t.Fatalf("%v: run go test -run TestSchema -update to write it", err)
	}
	if string(want) != got {
		t.Fatal("schema.sql is not the tables the files of migrations/ make. It is written from them: to change a table, add the next numbered file to migrations/, then run go test -run TestSchema -update")
	}
}

var (
	// sqlNoise matches comments, strings and quoted names, which say nothing about what SQL does.
	sqlNoise = regexp.MustCompile(`(?s)--[^\n]*|/\*.*?\*/|'(?:[^']|'')*'|"(?:[^"]|"")*"`)
	// dropOrRename matches the statements that take a table or a column away from the code that
	// uses it: DROP TABLE, and ALTER TABLE with DROP or RENAME.
	dropOrRename = regexp.MustCompile(`(?i)\bDROP\s+TABLE\b|\bALTER\s+TABLE\b[^;]*\b(DROP|RENAME)\b`)
)

// A release that may still run, after tifa deploy rollback, breaks on a table or a column that a
// later file dropped or renamed. A file that drops or renames one says, in a comment on its first
// line after the -- +goose lines, why no such release uses it. A table rebuild drops a table too:
// its comment says that the new table keeps every column.
func TestDropsSayWhy(t *testing.T) {
	names, err := fs.Glob(migrationFiles, "migrations/*.sql")
	if err != nil {
		t.Fatal(err)
	}
	for _, name := range names {
		text, err := fs.ReadFile(migrationFiles, name)
		if err != nil {
			t.Fatal(err)
		}
		if !dropOrRename.MatchString(sqlNoise.ReplaceAllString(string(text), " x ")) {
			continue
		}
		first := ""
		for line := range strings.Lines(string(text)) {
			if !strings.HasPrefix(line, "-- +goose ") {
				first = line
				break
			}
		}
		if why, ok := strings.CutPrefix(first, "--"); !ok || strings.TrimSpace(why) == "" {
			t.Errorf("%s drops or renames a table or a column. Its first line after the -- +goose lines must be a comment that says why no release that may still run uses it (drop or rename only in a release after every release you could roll back to stopped using it), or, for a table rebuild, that it keeps every column", name)
		}
	}
}
