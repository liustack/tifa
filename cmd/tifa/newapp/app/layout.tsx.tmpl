import { Link, Outlet } from '@tanstack/react-router'
import { TifaError } from 'tifa/client'
import './styles.css'

// The attributes of <html> and the head tags of every page. A page's head can set its own title.
export const documentHead = {
  htmlAttributes: { lang: 'en' },
  meta: [{ title: '{{.Title}}' }],
  links: [{ rel: 'icon', href: 'data:,' }],
}

// The root Layout wraps every page.
export default function Root() {
  return (
    <>
{{if not .Empty}}      <header>
        <nav>
          <Link to="/">Todos</Link>
          <Link to="/about">About</Link>
        </nav>
      </header>
{{end}}      <main>
        <Outlet />
      </main>
    </>
  )
}

// Error shows inside this Layout when a page fails to load or render and has no Error of its
// own, and for a URL that matches no page, as a TifaError with status 404.
export function ErrorBoundary({ error }: { error: unknown }) {
  if (error instanceof TifaError && error.status === 404) {
    return (
      <>
        <h1>Page not found</h1>
        <p>
          <Link to="/">{{if .Empty}}Back to the home page{{else}}Back to the todos{{end}}</Link>
        </p>
      </>
    )
  }
  return (
    <>
      <h1>Something went wrong</h1>
      <p role="alert">{error instanceof TifaError ? error.message : 'Try again in a moment.'}</p>
      <p>
        <Link to="/">{{if .Empty}}Back to the home page{{else}}Back to the todos{{end}}</Link>
      </p>
    </>
  )
}
