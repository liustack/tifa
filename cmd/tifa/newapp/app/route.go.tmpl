// Package app is the home page: the todo list and the form that adds a todo.
package app

import (
	"strings"
	"unicode/utf8"

	"github.com/liustack/tifa"

	"{{.Module}}/app/todos"
)

// Load runs on the server before the page renders, and again when the browser navigates here.
func Load(c *tifa.Ctx) ([]todos.Todo, error) {
	return todos.ListTodos(c.Context())
}

// AddInput is the body of POST. The page sends it as JSON through the POST function of ./+route.
type AddInput struct {
	Title string `json:"title"`
}

// Validate runs before POST. tifa.Fields answers 422 with a message per field, and the form shows
// each message next to its field.
func (in AddInput) Validate() error {
	switch n := utf8.RuneCountInString(strings.TrimSpace(in.Title)); {
	case n == 0:
		return tifa.Fields{"title": "Write what needs doing."}
	case n > 200:
		return tifa.Fields{"title": "Keep it under 200 characters."}
	}
	return nil
}

// POST adds a todo and answers with it. The page data loads again afterwards.
func POST(c *tifa.Ctx, in AddInput) (todos.Todo, error) {
	return todos.AddTodo(c.Context(), in.Title)
}
