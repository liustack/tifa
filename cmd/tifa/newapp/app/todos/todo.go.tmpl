// Package todos is the todo list: the Todo type and its queries. The home page lists and adds
// todos, and the page of one todo below this folder shows it and marks it done.
package todos

import (
	"context"
	"database/sql"
	"errors"
	"strings"

	"github.com/liustack/tifa"

	"{{.Module}}"
)

// Todo is one thing to do.
type Todo struct {
	ID    int64  `json:"id"`
	Title string `json:"title"`
	Done  bool   `json:"done"`
}

// ListTodos returns every todo, open ones first, newest first.
func ListTodos(ctx context.Context) ([]Todo, error) {
	rows, err := {{.Package}}.DB.QueryContext(ctx, `SELECT id, title, done FROM todos ORDER BY done, id DESC`)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	todos := []Todo{}
	for rows.Next() {
		var t Todo
		if err := rows.Scan(&t.ID, &t.Title, &t.Done); err != nil {
			return nil, err
		}
		todos = append(todos, t)
	}
	return todos, rows.Err()
}

// GetTodo returns the todo id, or tifa.ErrNotFound, which a page answers with 404.
func GetTodo(ctx context.Context, id int64) (Todo, error) {
	t := Todo{ID: id}
	err := {{.Package}}.DB.QueryRowContext(ctx, `SELECT title, done FROM todos WHERE id = ?`, id).Scan(&t.Title, &t.Done)
	if errors.Is(err, sql.ErrNoRows) {
		return Todo{}, tifa.ErrNotFound
	}
	return t, err
}

// AddTodo adds an open todo with title, without the spaces around it.
func AddTodo(ctx context.Context, title string) (Todo, error) {
	t := Todo{Title: strings.TrimSpace(title)}
	err := {{.Package}}.DB.QueryRowContext(ctx, `INSERT INTO todos (title) VALUES (?) RETURNING id`, t.Title).Scan(&t.ID)
	return t, err
}

// SetDone marks the todo id as done or open and returns it, or tifa.ErrNotFound.
func SetDone(ctx context.Context, id int64, done bool) (Todo, error) {
	t := Todo{ID: id}
	err := {{.Package}}.DB.QueryRowContext(ctx, `UPDATE todos SET done = ? WHERE id = ? RETURNING title, done`, done, id).Scan(&t.Title, &t.Done)
	if errors.Is(err, sql.ErrNoRows) {
		return Todo{}, tifa.ErrNotFound
	}
	return t, err
}
