package healthz

import (
	"net/http/httptest"
	"path/filepath"
	"testing"

	"github.com/liustack/tifa"
	"github.com/liustack/tifa/tifatest"

	"{{.Module}}"
)

// useTestDB gives the test a fresh, empty database.
func useTestDB(t *testing.T) {
	t.Helper()
	db, err := {{.Package}}.OpenDB(filepath.Join(t.TempDir(), "test.db"))
	if err != nil {
		t.Fatal(err)
	}
	{{.Package}}.DB = db
	t.Cleanup(func() { db.Close() })
}

func TestGETAnswers204WhileTheDatabaseAnswers(t *testing.T) {
	useTestDB(t)
	c, rec := tifatest.NewCtx(t, httptest.NewRequest("GET", "/healthz", nil))
	if err := GET(c); err != nil {
		t.Fatal(err)
	}
	if rec.Code != 204 {
		t.Fatalf("status %d, want 204", rec.Code)
	}
}

func TestGETAnswers503WhenTheDatabaseIsDown(t *testing.T) {
	useTestDB(t)
	if err := {{.Package}}.DB.Close(); err != nil {
		t.Fatal(err)
	}
	c, _ := tifatest.NewCtx(t, httptest.NewRequest("GET", "/healthz", nil))
	err := GET(c)
	if e, ok := err.(tifa.Error); !ok || e.Status != 503 {
		t.Fatalf("GET: %v, want a tifa.Error with status 503", err)
	}
}
