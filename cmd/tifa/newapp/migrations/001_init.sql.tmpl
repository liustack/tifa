-- The first tables of the app. A later change goes in the next file, 002_<what>.sql: see
-- migrate.go. IF NOT EXISTS lets a database made before migrations/ take this file as run.

{{if not .Empty}}CREATE TABLE IF NOT EXISTS todos (
  id    INTEGER PRIMARY KEY,
  title TEXT    NOT NULL,
  done  INTEGER NOT NULL DEFAULT 0
);

{{end}}-- The sessions of tifa.SetSession (sessions.go), so a restart signs nobody out.
CREATE TABLE IF NOT EXISTS sessions (
  key    TEXT    PRIMARY KEY,
  data   BLOB    NOT NULL,
  expiry INTEGER NOT NULL -- Unix time in milliseconds
) WITHOUT ROWID;
CREATE INDEX IF NOT EXISTS sessions_by_expiry ON sessions (expiry);
