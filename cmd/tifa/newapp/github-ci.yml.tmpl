# tifa wrote this file once and never changes it. It is yours to edit.
name: CI
permissions:
  contents: read
on:
  pull_request:
  push:
    branches: [main]
jobs:
  check:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-go@v7
        with:
          go-version: '{{.GoMinor}}.x'
          check-latest: true
{{- if .Node}}
{{- if eq .Run "pnpm"}}
      - uses: pnpm/action-setup@v6
{{- if .PnpmVersion}}
        with:
          version: {{.PnpmVersion}}
{{- end}}
      - uses: actions/setup-node@v7
        with:
          node-version: 24
          cache: pnpm
      # The prepare script is skipped: tifa check writes .tifa/ itself, in a step whose findings
      # GitHub can mark on the files.
      - run: pnpm install --frozen-lockfile --ignore-scripts
{{- else}}
      - uses: actions/setup-node@v7
        with:
          node-version: 24
          cache: npm
      - run: npm ci
{{- end}}
{{- end}}
      - run: go tool tifa check
      # Stops the build when the Go standard library or a package the app calls has a known hole.
      - run: go run golang.org/x/vuln/cmd/govulncheck@latest ./...
