// Package {{.Package}} is the root package of the app: its hooks and the resources the whole app
// shares, such as the database. The domains under app/ import it, and by convention it imports
// nothing under app/, so any domain can use it without an import cycle.
package {{.Package}}

import (
	"database/sql"
	_ "embed"

	// The SQLite driver is pure Go and needs no C compiler, so the app builds with CGO_ENABLED=0.
	_ "github.com/liustack/sqlite"
)

// DB is the database of the app. OnStart opens it and OnShutdown closes it. Tests replace it
// with a fresh database of their own.
var DB *sql.DB

//go:embed schema.sql
var schema string

// OpenDB opens the SQLite database at path, creating the file when it is missing, and creates
// the tables of schema.sql that do not exist yet.
func OpenDB(path string) (*sql.DB, error) {
	// The pragmas run on every connection of the pool. WAL lets reads go on during a write,
	// and SQLite checks foreign keys only when asked to. A write waits up to 5s for another one
	// by default, so busy_timeout needs no setting. In SQL text, strings go in single quotes:
	// double quotes mean a column or table name.
	db, err := sql.Open("sqlite", "file:"+path+"?_pragma=journal_mode(WAL)&_pragma=synchronous(NORMAL)&_pragma=foreign_keys(1)")
	if err != nil {
		return nil, err
	}
	if _, err := db.Exec(schema); err != nil {
		db.Close()
		return nil, err
	}
	return db, nil
}
