// Package {{.Package}} is the root package of the app: its hooks and the resources the whole app
// shares, such as the database. The domains under app/ import it.
package {{.Package}}

import (
	"context"
	"database/sql"
	"embed"
	"errors"
	"fmt"
	"io/fs"
	"log/slog"
	"os"

	// The SQLite driver is pure Go and needs no C compiler, so the app builds with CGO_ENABLED=0.
	_ "github.com/liustack/sqlite"
	"github.com/liustack/sqlite/replica"
	"github.com/pressly/goose/v3"
)

// DB is the database of the app. OnStart opens it and OnShutdown closes it. Tests replace it
// with a fresh database of their own.
var DB *sql.DB

// Backup copies every commit of DB to the S3 store of DBBackup, when it is set. OnStart starts it
// before it opens DB, and OnShutdown closes it after DB. Backup.Sync(ctx) waits until what was
// committed is in the store.
var Backup *replica.Replica

// migrationFiles holds the changes to the tables, one numbered goose file per change:
// 001_init.sql, 002_<what>.sql and so on. Never edit a file that ran anywhere but on your machine:
// add the next number. The rules are in AGENTS.md and in "Change the tables" in
// docs/guides/database.md of Tifa.
//
//go:embed migrations/*.sql
var migrationFiles embed.FS

// OpenDB opens the SQLite database at path, creating the file when it is missing, after it runs
// the files of migrations/ that the database has not run yet.
func OpenDB(path string) (*sql.DB, error) {
	if err := migrate(context.Background(), path, migrationFiles); err != nil {
		return nil, err
	}
	return open(path)
}

// open opens the database at path. The pragmas run on every connection of the pool. WAL lets
// reads go on during a write, and SQLite checks foreign keys only when asked to. A write waits up
// to 5s for another one by default, so busy_timeout needs no setting. _txlock=immediate makes a
// transaction take the write lock at BEGIN, so writers wait their turn instead of failing with
// "database is locked" halfway: start a transaction that only reads with
// sql.TxOptions{ReadOnly: true}. In SQL text, strings go in single quotes: double quotes mean a
// column or table name.
func open(path string) (*sql.DB, error) {
	return sql.Open("sqlite", "file:"+path+"?_pragma=journal_mode(WAL)&_pragma=synchronous(NORMAL)&_pragma=foreign_keys(1)&_txlock=immediate")
}

// migrate runs the files of the migrations/ folder of files that the database at path has not run
// yet, with goose, each in a transaction of its own. Without db.backup, it first copies the
// database to path.before-migrations.
func migrate(ctx context.Context, path string, files fs.FS) error {
	dir, err := fs.Sub(files, "migrations")
	if err != nil {
		return err
	}
	// goose gets a pool of one connection, which Close drops: a file with
	// -- +goose NO TRANSACTION, such as a table rebuild, turns foreign keys off on it.
	db, err := open(path)
	if err != nil {
		return err
	}
	defer db.Close()
	db.SetMaxOpenConns(1)
	p, err := goose.NewProvider(goose.DialectSQLite3, db, dir)
	if err != nil {
		return err
	}
	current, newest, err := p.GetVersions(ctx)
	if err != nil {
		return err
	}
	if current > newest {
		// A newer release ran more files and was rolled back. goose skips them, and this release
		// runs on those tables.
		slog.Warn("migrations: the database ran files this release does not have", "database_version", current, "newest_file", newest)
	}
	if DBBackup == "" && current > 0 && current < newest {
		// VACUUM INTO writes a consistent copy, and fails when the file exists.
		if err := os.Remove(path + ".before-migrations"); err != nil && !errors.Is(err, fs.ErrNotExist) {
			return err
		}
		if _, err := db.ExecContext(ctx, "VACUUM INTO ?", path+".before-migrations"); err != nil {
			return err
		}
	}
	ran, err := p.Up(ctx)
	if err != nil {
		return fmt.Errorf("migrations: %w", err)
	}
	for _, r := range ran {
		slog.Info("migrations: ran", "file", r.Source.Path)
	}
	return nil
}

// StartBackup starts copying every commit of the database at path to the S3 URL url, about a
// second after it. When the file is missing, as on a new machine, it first restores the database
// from url, unless the store holds none yet. Call it before OpenDB.
func StartBackup(ctx context.Context, path, url string) (*replica.Replica, error) {
	if AWSAccessKeyID == "" || AWSSecretAccessKey == "" {
		return nil, errors.New("db.backup is set: set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY too")
	}
	cfg := replica.Config{
		URL:         url,
		Credentials: replica.StaticCredentials(replica.Credentials{AccessKeyID: AWSAccessKeyID, SecretAccessKey: AWSSecretAccessKey}),
		// The uploads run in the background, and a store that is down never fails a write.
		OnError: func(err error) { slog.Error("database backup", "err", err) },
	}
	if _, err := os.Stat(path); errors.Is(err, fs.ErrNotExist) {
		_, err := replica.Restore(ctx, path, cfg, replica.RestoreOptions{})
		if err != nil && !errors.Is(err, replica.ErrNoReplica) {
			return nil, err
		}
	}
	return replica.New(ctx, path, cfg)
}
