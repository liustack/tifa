package {{.Package}}

import "context"

// OnStart runs once before the app listens. A returned error stops the app.
func OnStart() error {
	db, err := OpenDB(dbPath())
	if err != nil {
		return err
	}
	DB = db
	return nil
}

// OnShutdown runs after a stop signal, once the requests in flight have finished.
func OnShutdown(ctx context.Context) error {
	return DB.Close()
}

