package {{.Package}}

import (
	"context"

	"github.com/liustack/tifa"
)

// OnStart runs once before the app listens. A returned error stops the app.
func OnStart(context.Context) error {
	db, err := OpenDB(DBPath)
	if err != nil {
		return err
	}
	DB = db
	// Sessions live in the database, so a restart or a deploy signs nobody out.
	tifa.SetSessionStore(sessionStore{db})
	return nil
}

// OnShutdown runs after a stop signal, once the requests in flight have finished.
func OnShutdown(ctx context.Context) error {
	return DB.Close()
}

