{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./shop/*"],
      "tifa/client": ["./shop/runtime/client.tsx"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../domain/*.ts", "shop/**/*.ts", "shop/**/*.tsx"],
  "exclude": ["node_modules", ".output", "dist"]
}
