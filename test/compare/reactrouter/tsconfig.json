{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./shop/*"],
      "@tanstack/react-router": ["./shop/runtime/router.tsx"],
      "tifa/client": ["./shop/runtime/client.tsx"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "../domain/*.ts", "shop/**/*.ts", "shop/**/*.tsx"],
  "exclude": ["node_modules", "build"]
}
